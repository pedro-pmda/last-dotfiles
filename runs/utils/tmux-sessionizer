#!/usr/bin/env bash
# run-os: any
# run-desc: 🔍 Elegir proyecto con fzf y abrir su sesión tmux

# Selecciona un subdirectorio dentro de ~/kaizen o ~/zooplus usando fzf
# (~/zooplus solo existe en máquinas de trabajo, no en todas)
search_roots=()
for root in ~/kaizen ~/zooplus; do
	[[ -d "$root" ]] && search_roots+=("$root")
done
selected=$(find "${search_roots[@]}" -mindepth 1 -maxdepth 1 -type d | fzf)
if [[ -z "$selected" ]]; then
	exit 0
fi

# Normaliza el nombre de la sesión tmux: además de ":,/", el "." también es
# separador de target en tmux (sesión:ventana.pane), así que un nombre como
# "pedropalazon.dev" rompe cualquier "-t $selected_name" posterior.
selected_name=$(basename "$selected" | tr ":,/." "____")

# Función para cambiar a la sesión tmux correspondiente
switch_to() {
    if [[ -z "$TMUX" ]]; then
        tmux attach-session -t "$selected_name"
    else
        tmux switch-client -t "$selected_name"
    fi
}

# Si la sesión ya existe, simplemente cambiar a ella
if tmux has-session -t="$selected_name" 2>/dev/null; then
    switch_to
    exit 0
fi

# Crear una nueva sesión tmux y cambiar a ella
tmux new-session -ds "$selected_name" -c "$selected"
tmux send-keys -t "$selected_name" "ready-tmux" ^M
switch_to

