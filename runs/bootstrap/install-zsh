#!/usr/bin/env bash
# run-os: any
# run-desc: 🐚 Zsh + Antigen, p10k, fzf, kube-ps1 y ~/.zshrc

set -euo pipefail

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
source "$LIB_DIR/brew-env.sh"
source "$LIB_DIR/apt.sh"

# La raíz del repo se deduce del propio script: el symlink debe apuntar al clon real,
# viva donde viva, no a un ~/last-dotfiles asumido.
REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
CONFIG_SRC="$REPO_ROOT/configs/zsh-config/.zshrc"
CONFIG_DEST="$HOME/.zshrc"
P10K_SRC="$REPO_ROOT/configs/zsh-config/.p10k.zsh"
P10K_DEST="$HOME/.p10k.zsh"

echo "🍺 [1/8] Verificando instalación de Homebrew..."
if ! ensure_brew --optional; then
  echo "📦 Instalando Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  ensure_brew
else
  echo "✅ Homebrew ya está instalado."
fi

# Los symlinks van antes de instalar nada: es lo único que este script no puede
# dejar a medias. Antes era el paso 6 de 8, así que un fallo de brew en el paso 3
# abortaba con set -e y dejaba la máquina sin ~/.zshrc enlazado.
echo "🔗 [2/8] Enlazando ~/.zshrc y ~/.p10k.zsh..."
stamp=$(date +%Y%m%d-%H%M%S)

link() { # link <origen> <destino>
  local src="$1" dest="$2"
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    echo "⚠️  $dest existe y no es un symlink → backup en $dest.backup-$stamp"
    mv "$dest" "$dest.backup-$stamp"
  fi
  ln -sfn "$src" "$dest"
  echo "🔗 $dest -> $src"
}

link "$CONFIG_SRC" "$CONFIG_DEST"
# El tema del prompt. Sin esto, .zshrc lo sourcea pero no existe en una máquina
# nueva, así que p10k arranca su asistente en vez de tu prompt.
link "$P10K_SRC" "$P10K_DEST"

echo "🔍 [3/8] Verificando instalación de Zsh..."
if ! command -v zsh &> /dev/null; then
  echo "📦 Instalando Zsh..."
  if [[ "$(uname -s)" == "Linux" ]]; then
    # apt registra el binario en /etc/shells automáticamente; el zsh de Linuxbrew no,
    # y eso hace que chsh lo rechace más abajo.
    apt_install zsh
  else
    brew install zsh
  fi
else
  echo "✅ Zsh ya está instalado."
fi

echo "🔧 [4/8] Instalando herramientas necesarias con Homebrew..."
brew install fzf thefuck autojump
# --all: sin él, el instalador de fzf hace tres preguntas y se queda esperando
# stdin dentro de un ./run desatendido.
"$(brew --prefix fzf)/install" --all

# La fuente que exige el prompt. configs/zsh-config/.p10k.zsh trae
# POWERLEVEL9K_MODE=nerdfont-v3, así que sin una Nerd Font instalada el prompt
# sale con cuadraditos en lugar de iconos.
echo "🔤 [5/8] Instalando la Nerd Font que necesita Powerlevel10k..."
if [[ "$(uname -s)" == "Darwin" ]]; then
  if brew list --cask font-meslo-lg-nerd-font &>/dev/null; then
    echo "✅ MesloLG Nerd Font ya está instalada."
  else
    brew install --cask font-meslo-lg-nerd-font
  fi
else
  # En Linux no hay casks. Se bajan las cuatro variantes que recomienda p10k
  # desde su propio repositorio de medios.
  FONT_DIR="$HOME/.local/share/fonts"
  mkdir -p "$FONT_DIR"
  base="https://github.com/romkatv/powerlevel10k-media/raw/master"
  installed=0
  for variant in "Regular" "Bold" "Italic" "Bold%20Italic"; do
    name="MesloLGS NF ${variant//\%20/ }.ttf"
    if [[ -f "$FONT_DIR/$name" ]]; then
      continue
    fi
    echo "   ⬇️  $name"
    curl -fsSL "$base/MesloLGS%20NF%20$variant.ttf" -o "$FONT_DIR/$name"
    installed=$((installed + 1))
  done
  if [[ $installed -gt 0 ]]; then
    command -v fc-cache &>/dev/null && fc-cache -f "$FONT_DIR" >/dev/null
    echo "✅ $installed variantes instaladas en $FONT_DIR"
  else
    echo "✅ MesloLGS NF ya estaba instalada."
  fi
fi
echo "   ⚠️  Selecciónala como fuente en tu terminal (en Ghostty: font-family = MesloLGS NF)"

echo "📦 [6/8] Instalando Antigen..."
if [[ -s "$HOME/.antigen.zsh" ]]; then
  echo "✅ Antigen ya está instalado."
else
  curl -fsSL https://raw.githubusercontent.com/zsh-users/antigen/master/bin/antigen.zsh -o "$HOME/.antigen.zsh"
  # Sin esto, un 404 o una redirección rota deja un fichero que existe pero no
  # sirve, y el .zshrc no puede distinguirlo de una instalación buena.
  if [[ ! -s "$HOME/.antigen.zsh" ]]; then
    echo "❌ La descarga de Antigen salió vacía"
    exit 1
  fi
fi

echo "☸️ [7/8] Clonando kube-ps1..."
if [[ -d "$HOME/.kube-ps1" ]]; then
  echo "✅ kube-ps1 ya existe."
else
  git clone https://github.com/jonmosco/kube-ps1.git "$HOME/.kube-ps1"
fi

echo "📤 [8/8] Comprobando si Zsh es tu shell por defecto..."
zsh_path="$(command -v zsh)"

if [[ "$SHELL" == "$zsh_path" ]]; then
  echo "✅ Zsh ya es tu shell por defecto."
else
  # chsh rechaza cualquier shell que no esté en /etc/shells. El zsh de Homebrew
  # nunca se registra solo, así que en macOS esto fallaba siempre y, con set -e,
  # se llevaba por delante el final del script.
  if ! grep -qxF "$zsh_path" /etc/shells 2>/dev/null; then
    echo "📝 $zsh_path no está en /etc/shells; añadiéndolo (pide sudo)..."
    if ! echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null; then
      echo "⚠️  No se pudo escribir en /etc/shells. Hazlo a mano y luego:"
      echo "    chsh -s $zsh_path"
      exit 0
    fi
  fi

  echo "🔄 Cambiando tu shell por defecto a Zsh (pide tu contraseña)..."
  if ! chsh -s "$zsh_path"; then
    echo "⚠️  chsh falló. Cámbialo a mano cuando puedas:"
    echo "    chsh -s $zsh_path"
  fi
fi

echo "✅ ¡Listo! Abre una nueva terminal o ejecuta: source ~/.zshrc"
