#!/bin/bash

set -e

echo "🍺 [1/8] Verificando instalación de Homebrew..."
if ! command -v brew &> /dev/null; then
  echo "📦 Instalando Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # El instalador solo añade brew a ~/.zshrc; hay que ponerlo en el PATH de
  # este proceso para poder usarlo en lo que queda de script.
  for brew_bin in /home/linuxbrew/.linuxbrew/bin/brew /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [[ -x "$brew_bin" ]] && eval "$("$brew_bin" shellenv)" && break
  done
else
  echo "✅ Homebrew ya está instalado."
fi

echo "🔍 [2/8] Verificando instalación de Zsh..."
if ! command -v zsh &> /dev/null; then
  echo "📦 Instalando Zsh..."
  if [[ "$(uname -s)" == "Linux" ]]; then
    # apt registra el binario en /etc/shells automáticamente; el zsh de Linuxbrew no,
    # y eso hace que chsh lo rechace más abajo.
    sudo apt-get install -y zsh
  else
    brew install zsh
  fi
else
  echo "✅ Zsh ya está instalado."
fi

echo "🔧 [3/8] Instalando herramientas necesarias con Homebrew..."
brew install fzf kubectx kubectx thefuck autojump
$(brew --prefix)/opt/fzf/install

echo "📦 [4/8] Instalando Antigen..."
curl -L git.io/antigen > ~/.antigen.zsh

echo "☸️ [5/8] Clonando kube-ps1..."
git clone https://github.com/jonmosco/kube-ps1.git ~/.kube-ps1 || echo "-> kube-ps1 ya existe."

echo "🔗 [6/8] Enlazando ~/.zshrc a configs/zsh-config/.zshrc..."

# La raíz del repo se deduce del propio script: el symlink debe apuntar al clon real,
# viva donde viva, no a un ~/last-dotfiles asumido.
REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
CONFIG_SRC="$REPO_ROOT/configs/zsh-config/.zshrc"
CONFIG_DEST="$HOME/.zshrc"

if [[ -e "$CONFIG_DEST" && ! -L "$CONFIG_DEST" ]]; then
  stamp=$(date +%Y%m%d-%H%M%S)
  echo "⚠️  $CONFIG_DEST existe y no es un symlink → backup en $CONFIG_DEST.backup-$stamp"
  mv "$CONFIG_DEST" "$CONFIG_DEST.backup-$stamp"
fi
ln -sfn "$CONFIG_SRC" "$CONFIG_DEST"
echo "🔗 $CONFIG_DEST -> $CONFIG_SRC"

echo "📤 [7/8] Comprobando si Zsh es tu shell por defecto..."

if [ "$SHELL" != "$(which zsh)" ]; then
  echo "🔄 Cambiando tu shell por defecto a Zsh..."
  chsh -s $(which zsh)
else
  echo "✅ Zsh ya es tu shell por defecto."
fi

echo "✅ [8/8] ¡Listo! Abre una nueva terminal o ejecuta: source ~/.zshrc"

