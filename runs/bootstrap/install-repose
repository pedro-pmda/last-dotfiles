#!/usr/bin/env bash
# run-os: darwin
# run-desc: 😌 Repose — recordatorios de descanso (barra de menú, sin Dock)

set -euo pipefail

# Guard: Repose solo existe para macOS (no hay equivalente oficial en Linux)
[[ "$(uname -s)" == "Darwin" ]] || { echo "⏭️  Solo macOS — nada que hacer en Linux"; exit 0; }

if [[ -d "/Applications/Repose.app" ]]; then
  echo "✅ Repose ya está instalado."
  exit 0
fi

GH_REPO="fikrikarim/repose"
url="https://github.com/$GH_REPO/releases/latest/download/Repose.dmg"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "⬇️  Descargando Repose..."
curl -fsSL "$url" -o "$tmp/Repose.dmg"

echo "📦 Montando el .dmg..."
hdiutil attach "$tmp/Repose.dmg" -nobrowse -quiet -mountpoint "$tmp/mnt"
cp -R "$tmp/mnt/Repose.app" /Applications/
hdiutil detach "$tmp/mnt" -quiet

echo "✅ Repose instalado"
