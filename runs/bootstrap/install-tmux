#!/usr/bin/env bash
# run-os: any
# run-desc: 🪟 tmux + su config (clipboard según el OS)

set -euo pipefail

# Homebrew puede haberse instalado en este mismo ./run pero no estar aún en el
# PATH de este proceso (el instalador solo lo añade a ~/.zshrc).
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
source "$LIB_DIR/brew-env.sh"
source "$LIB_DIR/apt.sh"
ensure_brew

# La raíz del repo se deduce del propio script: el symlink debe apuntar al clon real,
# viva donde viva, no a un ~/last-dotfiles asumido.
REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
CONFIG_SRC="$REPO_ROOT/configs/tmux-config"
CONFIG_DEST="$HOME/.config/tmux"

echo "🔧 Installing tmux via Homebrew..."
if command -v tmux &>/dev/null; then
  echo "✅ tmux ya está instalado."
else
  brew install tmux
fi

# pbcopy no existe en Linux. Se instalan los dos (X11 y Wayland) y clipboard.sh
# elige en cada yank, porque $WAYLAND_DISPLAY depende de la sesión gráfica en la
# que estés y no de la instalación.
if [[ "$(uname -s)" == "Linux" ]]; then
  echo "📋 Installing clipboard tools (xclip + wl-clipboard) via apt..."
  apt_install xclip wl-clipboard
fi

echo "📁 Creating config folder: $CONFIG_DEST"
mkdir -p "$CONFIG_DEST"

stamp=$(date +%Y%m%d-%H%M%S)

link() { # link <origen> <destino>
  local src="$1" dest="$2"
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    echo "⚠️  $dest existe y no es un symlink → backup en $dest.backup-$stamp"
    mv "$dest" "$dest.backup-$stamp"
  fi
  ln -sfn "$src" "$dest"
  echo "🔗 $dest -> $src"
}

# Antes este script generaba tmux.conf con un heredoc, horneando dentro el comando
# de portapapeles del OS. Eso lo convertía en el único config que no se podía
# editar desde el repo, y el fichero resultante no servía en la otra máquina.
link "$CONFIG_SRC/tmux.conf"    "$CONFIG_DEST/tmux.conf"
link "$CONFIG_SRC/clipboard.sh" "$CONFIG_DEST/clipboard.sh"

# El hook global de layout, el que usa `ready-tmux` cuando el proyecto no trae su
# propio .ready-tmux. Estaba copiado a mano; enlazado se puede editar desde el repo.
link "$REPO_ROOT/configs/tmux-examples/.ready-tmux-default" "$HOME/.ready-tmux"

echo "✅ Tmux installed and configured!"
echo "   Recarga con: tmux source-file ~/.config/tmux/tmux.conf   (o prefix + r)"
