#!/usr/bin/env bash

set -euo pipefail

# Homebrew puede haberse instalado en este mismo ./run pero no estar aún en el
# PATH de este proceso (el instalador solo lo añade a ~/.zshrc).
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
source "$LIB_DIR/brew-env.sh"
source "$LIB_DIR/apt.sh"
ensure_brew

echo "🔧 Installing tmux via Homebrew..."
if command -v tmux &>/dev/null; then
  echo "✅ tmux ya está instalado."
else
  brew install tmux
fi

echo "📁 Creating config folder: ~/.config/tmux"
mkdir -p ~/.config/tmux

CONFIG_PATH="$HOME/.config/tmux/tmux.conf"

# pbcopy no existe en Linux: instalamos xclip (X11) + wl-clipboard (Wayland) y
# elegimos entre ambos en tiempo de ejecución vía un pequeño wrapper, ya que
# $WAYLAND_DISPLAY depende de la sesión gráfica, no de la instalación.
if [[ "$(uname -s)" == "Linux" ]]; then
  echo "📋 Installing clipboard tools (xclip + wl-clipboard) via apt..."
  apt_install xclip wl-clipboard

  CLIPBOARD_SCRIPT="$HOME/.config/tmux/clipboard.sh"
  cat > "$CLIPBOARD_SCRIPT" <<'CLIP'
#!/usr/bin/env sh
if [ -n "$WAYLAND_DISPLAY" ]; then
  wl-copy
else
  xclip -selection clipboard -i
fi
CLIP
  chmod +x "$CLIPBOARD_SCRIPT"
  CLIP_CMD="$CLIPBOARD_SCRIPT"
else
  CLIP_CMD="pbcopy"
fi

# El resto de instaladores del repo respaldan lo que van a pisar; este destruía
# las ediciones a mano sin avisar.
if [[ -e "$CONFIG_PATH" ]]; then
  stamp=$(date +%Y%m%d-%H%M%S)
  echo "⚠️  $CONFIG_PATH ya existe → backup en $CONFIG_PATH.backup-$stamp"
  cp "$CONFIG_PATH" "$CONFIG_PATH.backup-$stamp"
fi

echo "📝 Writing tmux config to $CONFIG_PATH"

cat > "$CONFIG_PATH" <<EOF
set -g default-terminal "tmux-256color"
set -s escape-time 0
set -g base-index 1

unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

set-window-option -g mode-keys vi
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel '$CLIP_CMD'

bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

bind r source-file ~/.config/tmux/tmux.conf \\; display-message "tmux.conf reloaded"
EOF

echo "✅ Tmux installed and configured!"

