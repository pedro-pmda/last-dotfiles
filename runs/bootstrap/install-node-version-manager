#!/bin/bash

set -e

# Homebrew puede haberse instalado en este mismo ./run pero no estar aún en el
# PATH de este proceso (el instalador solo lo añade a ~/.zshrc).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/brew-env.sh"
ensure_brew

# Instalar NVM usando Homebrew
brew update
brew install nvm

# Crear directorio para NVM si no existe
mkdir -p ~/.nvm

# Prefix real de nvm en este brew (Linuxbrew, Apple Silicon o Intel Mac)
NVM_PREFIX="$(brew --prefix nvm)"

# Añadir configuración de entorno a tu shell config (por ejemplo, .zshrc o .bashrc)
CONFIG_FILE="${HOME}/.zshrc" # cambia si usas bash

if ! grep -q 'export NVM_DIR' "$CONFIG_FILE"; then
  {
    echo 'export NVM_DIR="$HOME/.nvm"'
    echo "[ -s \"$NVM_PREFIX/nvm.sh\" ] && \\. \"$NVM_PREFIX/nvm.sh\""
    echo "[ -s \"$NVM_PREFIX/etc/bash_completion.d/nvm\" ] && \\. \"$NVM_PREFIX/etc/bash_completion.d/nvm\""
  } >> "$CONFIG_FILE"
fi

# Cargar configuración en la sesión actual
export NVM_DIR="$HOME/.nvm"
source "$NVM_PREFIX/nvm.sh"

# Instalar la última versión de Node
nvm install node
nvm use node
nvm alias default node

echo "✅ NVM y la última versión de Node.js están instalados y configurados."

