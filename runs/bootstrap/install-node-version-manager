#!/usr/bin/env bash
# run-os: any
# run-desc: 📦 nvm + la última versión de Node

set -euo pipefail

# Homebrew puede haberse instalado en este mismo ./run pero no estar aún en el
# PATH de este proceso (el instalador solo lo añade a ~/.zshrc).
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/brew-env.sh"
ensure_brew

echo "🍺 Instalando NVM con Homebrew..."
if brew list nvm &>/dev/null; then
  echo "✅ nvm ya está instalado."
else
  brew install nvm
fi

# Crear directorio para NVM si no existe
mkdir -p ~/.nvm

# Prefix real de nvm en este brew (Linuxbrew, Apple Silicon o Intel Mac)
NVM_PREFIX="$(brew --prefix nvm)"

# Aquí antes se hacía `>> ~/.zshrc`. Como install-zsh convierte ~/.zshrc en un
# symlink al repo, eso escribía rutas absolutas de brew (/opt/homebrew/opt/nvm vs
# /home/linuxbrew/.linuxbrew/opt/nvm) dentro del fichero versionado, y quedaban
# mal en el otro OS. configs/zsh-config/.zshrc ya carga nvm vía $HOMEBREW_PREFIX,
# así que este script solo tiene que instalar la formula.

# Cargar configuración en la sesión actual
export NVM_DIR="$HOME/.nvm"
# nvm.sh usa variables sin definir, así que se relaja -u mientras se carga.
set +u
source "$NVM_PREFIX/nvm.sh"
set -u

# Instalar la última versión de Node
echo "📦 Instalando la última versión de Node..."
nvm install node
nvm use node
nvm alias default node

echo "✅ NVM y la última versión de Node.js están instalados y configurados."
