#!/usr/bin/env bash
# run-os: any
# run-desc: 🐳 Docker Desktop (macOS) / Engine (Linux)

set -euo pipefail

if command -v docker &> /dev/null; then
  echo "✅ Docker ya está instalado."
  exit 0
fi

if [[ "$(uname -s)" == "Linux" ]]; then
  echo "🐳 Instalando Docker Engine en Linux..."

  # El script de conveniencia de Docker (get.docker.com) detecta mal las distros
  # derivadas de Ubuntu como Mint: ID_LIKE="ubuntu debian" le hace decantarse por
  # "debian", y como no reconoce el codename de la derivada (p.ej. "zena" de Mint)
  # cae a la última versión de Debian que conoce — en la práctica añade un repo con
  # paquetes compilados contra librerías que no existen en el sistema real, y el
  # apt-get install posterior falla con "held broken packages". Se monta el repo a
  # mano en su lugar, con el codename real: en derivadas de Ubuntu ese codename no
  # está en /etc/os-release (que trae el de la propia derivada) sino en
  # /etc/upstream-release/lsb-release, que es donde Mint (y similares) exponen de
  # qué Ubuntu vienen.
  if [[ -f /etc/upstream-release/lsb-release ]]; then
    docker_distro="ubuntu"
    docker_codename="$(. /etc/upstream-release/lsb-release && echo "$DISTRIB_CODENAME")"
  else
    docker_distro="$(. /etc/os-release && echo "$ID")"
    docker_codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
  fi

  if [[ "$docker_distro" != "ubuntu" && "$docker_distro" != "debian" ]]; then
    echo "❌ Docker solo publica repo apt para Ubuntu y Debian; esta distro reporta '$docker_distro'."
    echo "   Instálalo a mano siguiendo https://docs.docker.com/engine/install/"
    exit 1
  fi

  echo "📦 Detectada base $docker_distro/$docker_codename — configurando el repo oficial de Docker..."
  source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/apt.sh"
  require_apt

  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL "https://download.docker.com/linux/$docker_distro/gpg" -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$docker_distro $docker_codename stable" \
    | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

  apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  echo "🔧 Habilitando y arrancando el servicio de Docker..."
  # WSL2 y las distros sin systemd no tienen systemctl: ahí el script oficial ya
  # deja el engine instalado y solo falta arrancarlo a mano.
  if command -v systemctl &>/dev/null; then
    sudo systemctl enable --now docker
  else
    echo "⚠️  Sin systemctl aquí. Arranca el daemon como corresponda en tu sistema."
  fi

  echo "👤 Añadiendo $USER al grupo 'docker' (para usar docker sin sudo)..."
  sudo usermod -aG docker "$USER"

  echo "✅ Docker Engine instalado. Cierra sesión y vuelve a entrar (o reinicia) para que el grupo 'docker' surta efecto."
else
  echo "🐳 Instalando Docker Desktop en macOS..."

  source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/brew-env.sh"
  ensure_brew

  # Actualizar Homebrew
  echo "🔄 Actualizando Homebrew..."
  brew update

  # Instalar Docker Desktop. El cask se llama docker-desktop; "docker" sigue
  # funcionando como alias, pero conviene no depender de él.
  echo "🍺 Instalando Docker Desktop..."
  brew install --cask docker-desktop

  echo "🚀 Abriendo Docker Desktop por primera vez (puede pedir permisos)..."
  open -a Docker

  echo "✅ Docker Desktop instalado. Espera unos segundos a que se inicie completamente."
fi
