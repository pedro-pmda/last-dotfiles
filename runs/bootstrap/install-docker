#!/bin/bash

set -e

if command -v docker &> /dev/null; then
  echo "✅ Docker ya está instalado."
  exit 0
fi

if [[ "$(uname -s)" == "Linux" ]]; then
  echo "🐳 Instalando Docker Engine en Linux con el script oficial de Docker..."
  curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
  sudo sh /tmp/get-docker.sh
  rm -f /tmp/get-docker.sh

  echo "🔧 Habilitando y arrancando el servicio de Docker..."
  sudo systemctl enable --now docker

  echo "👤 Añadiendo $USER al grupo 'docker' (para usar docker sin sudo)..."
  sudo usermod -aG docker "$USER"

  echo "✅ Docker Engine instalado. Cierra sesión y vuelve a entrar (o reinicia) para que el grupo 'docker' surta efecto."
else
  echo "🐳 Instalando Docker Desktop en macOS..."

  # Verificar si Homebrew está instalado
  if ! command -v brew &> /dev/null; then
    echo "❌ Homebrew no está instalado. Por favor instálalo primero desde https://brew.sh"
    exit 1
  fi

  # Actualizar Homebrew
  echo "🔄 Actualizando Homebrew..."
  brew update

  # Instalar Docker Desktop
  echo "🍺 Instalando Docker Desktop..."
  brew install --cask docker

  echo "🚀 Abriendo Docker Desktop por primera vez (puede pedir permisos)..."
  open -a Docker

  echo "✅ Docker Desktop instalado. Espera unos segundos a que se inicie completamente."
fi
