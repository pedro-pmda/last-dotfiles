#!/usr/bin/env bash
# run-os: any
# run-desc: 🛠  CLI: k9s, htop, glow, bat, lsd, lazygit, direnv, tree-sitter

set -euo pipefail

# Instala herramientas pequeñas de terminal y enlaza su configuración.
#
# Antes esto solo enlazaba configs, así que en una máquina nueva podías acabar
# con un ~/.config/glow perfectamente enlazado y sin glow instalado.
#
# Las tres tienen formula de Homebrew, que existe igual en macOS y en Linuxbrew,
# así que no hace falta ramificar por sistema operativo.
#
# Ojo: htop reescribe su htoprc cuando cambias ajustes desde su interfaz, y k9s
# puede reescribir su config.yaml al salir. Eso aparecerá como cambios en el repo,
# igual que pasa con el lazy-lock.json de nvim: es el precio de tenerlo versionado.

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
source "$LIB_DIR/brew-env.sh"

# La raíz del repo se deduce del propio script, no de un ~/last-dotfiles asumido.
REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
CONFIG_SRC="$REPO_ROOT/configs/cli-config"

# formula:binario:carpeta-de-config
# El binario no siempre se llama como la formula (tree-sitter-cli → tree-sitter),
# y no todas traen config versionada: las que no, solo se instalan.
TOOLS=(
  "k9s:k9s:k9s"
  "htop:htop:htop"
  "glow:glow:glow"
  "bat:bat:"
  "lsd:lsd:"
  "lazygit:lazygit:"
  "direnv:direnv:"
  "tree-sitter-cli:tree-sitter:"
)

# --- 1. Instalar lo que falte -------------------------------------------------
# Se comprueba con `command -v`, no con `brew list`: si ya tienes la herramienta
# por apt o compilada, se respeta en vez de instalar una segunda copia.
missing=()
for entry in "${TOOLS[@]}"; do
  formula="${entry%%:*}"
  rest="${entry#*:}"
  binary="${rest%%:*}"
  if command -v "$binary" &>/dev/null; then
    echo "✅ $binary ya está instalado ($(command -v "$binary"))"
  else
    missing+=("$formula")
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  ensure_brew
  echo "📦 Instalando con Homebrew: ${missing[*]}"
  brew install "${missing[@]}"
fi

# --- 2. Enlazar sus configs ---------------------------------------------------
# Se enlaza el DIRECTORIO de cada una, igual que con nvim, para que un fichero
# nuevo dentro (un skin de k9s, por ejemplo) no requiera tocar este script.
stamp=$(date +%Y%m%d-%H%M%S)
mkdir -p "$HOME/.config"

for entry in "${TOOLS[@]}"; do
  cfg="${entry##*:}"
  [[ -z "$cfg" ]] && continue   # sin config versionada: nada que enlazar

  src="$CONFIG_SRC/$cfg"
  dest="$HOME/.config/$cfg"

  if [[ ! -d "$src" ]]; then
    echo "⏭️  $cfg no tiene config en el repo, solo se instaló la herramienta"
    continue
  fi

  if [[ -e "$dest" && ! -L "$dest" ]]; then
    echo "⚠️  $dest existe y no es un symlink → backup en $dest.backup-$stamp"
    mv "$dest" "$dest.backup-$stamp"
  fi

  ln -sfn "$src" "$dest"
  echo "🔗 $dest -> $src"
done

echo "✅ Herramientas de CLI instaladas y configuradas"
