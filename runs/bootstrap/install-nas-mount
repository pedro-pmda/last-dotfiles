#!/usr/bin/env bash
# run-os: linux
# run-desc: 📚 Montar el NAS de bibliotecas por CIFS (Calibre no funciona sobre GVFS)

set -euo pipefail

[[ "$(uname -s)" == "Linux" ]] || exit 0

# GVFS (el montaje que usa Nautilus al "Conectar a servidor") no implementa flock
# correctamente, y Calibre lo necesita para metadata.db: sin esto, Calibre marca la
# biblioteca como "corrupta" aunque el archivo esté bien. La solución es un montaje
# CIFS real a nivel de kernel. Detalle completo del diagnóstico en
# ~/Downloads/calibre-nas-gvfs-corrupcion.md (fuera del repo).

if command -v mount.cifs &>/dev/null; then
  echo "✅ cifs-utils ya está instalado."
else
  source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/apt.sh"
  apt_install cifs-utils
fi

MOUNT_POINT="/mnt/bibliotecas"
sudo mkdir -p "$MOUNT_POINT"

# Las credenciales no se guardan nunca en el repo: viven solo en $HOME, con 600.
CREDENTIALS_FILE="$HOME/.smbcredentials"
if [[ -f "$CREDENTIALS_FILE" ]]; then
  echo "✅ $CREDENTIALS_FILE ya existe, no se toca."
else
  echo "🔑 Credenciales del NAS (no se guardan en el repo, solo en $CREDENTIALS_FILE):"
  read -r -p "   Usuario: " smb_user
  read -r -s -p "   Contraseña: " smb_pass
  echo
  read -r -p "   Dominio [WORKGROUP]: " smb_domain
  smb_domain="${smb_domain:-WORKGROUP}"

  cat > "$CREDENTIALS_FILE" <<EOF
username=$smb_user
password=$smb_pass
domain=$smb_domain
EOF
  chmod 600 "$CREDENTIALS_FILE"
  echo "✅ $CREDENTIALS_FILE creado."
fi

# x-systemd.automount es lo que hace que "funcione siempre que abras Calibre" sin
# montarlo a mano ni tenerlo montado de más: systemd monta el share la primera vez
# que algo accede a /mnt/bibliotecas y lo desmonta tras un rato sin uso. _netdev,nofail
# evitan que un NAS inalcanzable rompa el arranque. nobrl desactiva el locking por
# rango de bytes del cliente CIFS: con él activo (el default), calibre/sqlite daba
# "database is locked" al abrir la biblioteca — el NAS (UGREEN/Samba) no gestiona
# bien los oplocks que ese locking necesita. Sin byte-range locking, calibre sigue
# protegido igualmente porque abre metadata.db con su propio locking de aplicación.
FSTAB_LINE="//nas.local/bibliotecas $MOUNT_POINT cifs credentials=$CREDENTIALS_FILE,uid=$(id -u),gid=$(id -g),vers=3.0,file_mode=0777,dir_mode=0777,nobrl,x-systemd.automount,x-systemd.idle-timeout=600,_netdev,nofail 0 0"

if grep -qxF "$FSTAB_LINE" /etc/fstab 2>/dev/null; then
  echo "✅ /etc/fstab ya tiene la entrada correcta para $MOUNT_POINT, no se toca."
elif grep -qF "$MOUNT_POINT" /etc/fstab 2>/dev/null; then
  # Ya había una línea para este mount point pero con opciones distintas (p.ej.
  # una versión anterior del script sin nobrl) — se sustituye por la actual en
  # vez de dejar dos líneas o quedarse con la vieja.
  echo "📝 Actualizando la entrada de $MOUNT_POINT en /etc/fstab..."
  sudo sed -i "\\#$MOUNT_POINT#d" /etc/fstab
  echo "$FSTAB_LINE" | sudo tee -a /etc/fstab > /dev/null
  echo "✅ /etc/fstab actualizado."
else
  echo "📝 Añadiendo $MOUNT_POINT a /etc/fstab..."
  echo "$FSTAB_LINE" | sudo tee -a /etc/fstab > /dev/null
  echo "✅ /etc/fstab actualizado."
fi

# Se paran las unidades viejas antes del reload por si había un montaje activo con
# opciones antiguas (si no, systemd lo dejaría montado tal cual hasta que expire el
# idle-timeout, ignorando el cambio). daemon-reload regenera las unidades a partir
# del fstab, pero no las arranca por sí solo — sin el start, el automount se queda
# "inactive (dead)" hasta el próximo reboot. Todo esto se hace siempre (no solo al
# tocar el fstab), para que volver a correr el script también sirva de "arréglamelo".
MOUNT_UNIT="$(systemd-escape --path --suffix=mount "$MOUNT_POINT")"
AUTOMOUNT_UNIT="$(systemd-escape --path --suffix=automount "$MOUNT_POINT")"
sudo systemctl stop "$MOUNT_UNIT" "$AUTOMOUNT_UNIT" 2>/dev/null || true
sudo systemctl daemon-reload
sudo systemctl start "$AUTOMOUNT_UNIT"

echo
echo "✅ Montaje CIFS listo. Se activa solo al acceder a $MOUNT_POINT (p. ej. desde Calibre)."
echo "   Paso manual pendiente en Calibre (Preferences → Switch/create library),"
echo "   repuntar cada biblioteca de la ruta gvfs a la ruta CIFS:"
echo "     $MOUNT_POINT/El Placer de la Lectura"
echo "     $MOUNT_POINT/El Artesano del Codigo"
