#!/usr/bin/env bash

set -euo pipefail

# Sin esto, un ./run recién clonado moría aquí con "brew: command not found":
# este script se ejecutaba antes de que install-home-brew hubiera corrido.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/brew-env.sh"
ensure_brew

if command -v k3d &>/dev/null; then
  echo "✅ k3d ya está instalado."
else
  echo "🔄 Actualizando Homebrew..."
  brew update

  echo "🍺 Instalando k3d (wrapper de K3s para Docker)..."
  brew install k3d
fi

echo "🐳 Verificando si Docker está corriendo..."
if ! docker info &>/dev/null; then
  echo "⚠️  Docker no parece estar activo. Arráncalo (Docker Desktop en macOS, 'sudo systemctl start docker' en Linux) y vuelve a intentarlo."
  exit 1
fi

CLUSTER_NAME="peter-cluster"

if k3d cluster list "$CLUSTER_NAME" &>/dev/null; then
  echo "✅ El cluster '$CLUSTER_NAME' ya existe."
else
  echo "🚀 Creando cluster K3s local usando k3d..."
  k3d cluster create "$CLUSTER_NAME" --agents 2 --port 8080:80@loadbalancer
  echo "✅ K3s cluster creado."
fi

echo "   Puedes verificarlo con: kubectl get nodes"

