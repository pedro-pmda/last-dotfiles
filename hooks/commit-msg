#!/bin/sh
#
# Called by "git commit" with one argument, the name of the file
# that has the commit message.  The hook should exit with non-zero
# status after issuing an appropriate message if it wants to stop the
# commit.  The hook is allowed to edit the commit message file.
#
# Estaba inerte: `head -n 1 ""` había perdido su "$1" (así que leía un fichero
# vacío) y el guard era `if [ 0 -ne 0 ]`, literalmente nunca cierto. Se usan
# también -q y -E en vez de las opciones largas de GNU, que no son POSIX.

if ! head -n 1 "$1" | grep -q -E '^(MAJOR|MINOR|REVISION) \| .+'; then
    echo "Error: commit message must match ZPL format: <MAJOR|MINOR|REVISION> | [<STORY_NUMBER>:] <COMMIT_MESSAGE>"
    exit 1
fi
