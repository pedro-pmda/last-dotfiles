#!/bin/sh

MODIFIED=$(git diff --name-only --cached ui/ | grep -E '\.(vue|ts)$' | grep -v '__tests__/')

# Si no hay archivos modificados, salir del script
if [ -z "$MODIFIED" ]; then
    echo "✅ No modified files to check."
    exit 0
fi

for file in $MODIFIED; do
    echo "🔍 Checking $file ..."

    # El código de salida se captura del subshell, no dentro. Antes `RES=$?` se
    # asignaba en la línea 23, dentro de los paréntesis, así que el padre veía
    # siempre RES=0 y el hook nunca rechazaba un commit.
    (
        cd "$(git rev-parse --show-toplevel)" || exit 1
        cd ui || exit 1
        echo "🎨 Formatting $file with Prettier..."
        npm run format "../$file" || exit $?

        echo "🛠 Fixing lint issues in $file..."
        npm run lint:fix "../$file" || exit $?
    )
    RES=$?

    if [ $RES -eq 0 ]; then
        git add "$file"
        echo "✅ Added $file to commit after formatting & fixing"
    else
        echo "❌ Error in $file, commit rejected."
        exit 1
    fi
done

exit 0
