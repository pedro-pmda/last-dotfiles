#!/usr/bin/env bash
set -euo pipefail

# Ventana 1: editor
# Renombra la ventana actual y abre nvim en el directorio actual
tmux rename-window editor
tmux send-keys -t editor 'nvim .' C-m

# Ventana 2: claude
# Lanza Claude Code en su propia ventana
tmux new-window -n claude -c "#{pane_current_path}"
tmux send-keys -t claude 'claude' C-m

# Ventana 3: run
# Libre — aquí arrancas tú el server (frontend o backend) cuando toque
tmux new-window -n run -c "#{pane_current_path}"

# Volver a editor
tmux select-window -t editor
